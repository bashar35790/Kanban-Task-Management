
DATABASE_URL="postgresql://user:password@host:5432/kanban?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/kanban?schema=public"

BETTER_AUTH_SECRET="replace-with-a-random-32-char-secret"

BETTER_AUTH_URL="https://your-app-name.onrender.com"

# Google OAuth — get from Google Cloud Console → APIs & Services → Credentials
